# ─────────────────────────────────────────────────────────────────────────────
# Houseruled environment
#
# Houseruled runs entirely on Cloudflare - the app on Workers (via OpenNext),
# live rooms as Durable Objects, and the library on D1. There are NO backend
# secrets to configure for local dev: `next dev` runs a local "table demo", and
# `wrangler dev` / a deploy gives real multiplayer with no keys to paste.
#
# Everything below is optional and public (NEXT_PUBLIC_*, inlined at build time).
# Copy to `.env.local` to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── SEO ───────────────────────────────────────────────────────────────────────
# Canonical origin of your deployment, no trailing slash (e.g. the workers.dev
# URL or a custom domain). Used for canonical URLs, sitemap, robots, OG tags.
NEXT_PUBLIC_SITE_URL=

# ── Google AdSense (optional) ─────────────────────────────────────────────────
# Leave blank to disable ads entirely (no script, no empty boxes). Set the client
# to switch on the single ad slot + /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# ── Support link (optional) ───────────────────────────────────────────────────
# Overrides the default "Buy me a coffee" URL.
NEXT_PUBLIC_DONATE_URL=
